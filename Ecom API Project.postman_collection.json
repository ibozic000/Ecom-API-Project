            "exec": [
              "let jsonData=pm.response.json();\r\n\r\npm.environment.set(\"token\", jsonData.accessToken)\r\n\r\n\r\nconsole.log(pm.environment.get(\"token\", jsonData.accessToken))"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
